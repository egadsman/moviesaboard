# MoviesAboard compose configuration. Copy to .env (git-ignored) and
# edit; docker compose reads it automatically. Every variable is
# optional — plain `docker compose up` with no .env airs the demo
# station on http://localhost:8080. Full docs: docs/deploy-docker.md

# Published ports. HTTP is always on; HTTPS only answers when TLS is on.
# Ports bind all interfaces; prefix with a host address to restrict,
# e.g. MOVIESABOARD_HTTP_PORT=127.0.0.1:8080 for localhost only.
#MOVIESABOARD_HTTP_PORT=8080
#MOVIESABOARD_HTTPS_PORT=8443

# Host directory mounted at /data in both containers — content, state,
# library.json, schedule.json, vendor, certs all live here.
#MOVIESABOARD_DATA=./station-data

# An existing frozen-layout content directory (content/<slug>/index.m3u8
# + seg-*.ts + meta.json) to mount at /data/content (station read-write,
# web read-only). Leave unset to keep content inside MOVIESABOARD_DATA.
#MOVIESABOARD_CONTENT=

# off | self-signed | provided (see docs/deploy-docker.md#tls).
# self-signed: the station generates a cert pair into /data/certs at
# boot. provided: drop fullchain.pem + privkey.pem there yourself.
#MOVIESABOARD_TLS=off

# Station identity. STATION_TZ is an IANA zone (e.g. America/Chicago);
# empty uses the container's timezone.
#STATION_NAME=MoviesAboard
#STATION_TZ=

# auto: generate demo fixtures when /data/content holds nothing beyond
# the demo's own titles and some are missing or broken (repairs a
# crashed encode; never runs beside real content); off: never.
#MOVIESABOARD_DEMO=auto

# How often the station checks whether the published schedule's week
# has ended and the new week needs planning.
#MOVIESABOARD_REPLAN_MINUTES=5
