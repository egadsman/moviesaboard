# MoviesAboard weekly replan check (see docs/deploy-station.md).
# Cheap staleness probe: recompiles the schedule only on the first run
# after the published week ends. Point MOVIESABOARD_CONFIG at your config
# with a drop-in; set User= and the path to the account that owns the
# checkout before installing.
[Unit]
Description=MoviesAboard replan (recompile schedule once a new week begins)

[Service]
Type=oneshot
User=station
Environment=MOVIESABOARD_CONFIG=/srv/moviesaboard/station.config.json
ExecStart=/usr/bin/env node /home/station/git/moviesaboard/scripts/station-compile.js --config ${MOVIESABOARD_CONFIG} --check-stale
Nice=10
